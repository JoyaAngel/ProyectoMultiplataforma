<%- include('../partials/layout-header', { title: 'Dashboard', currentPage: 'dashboard' }) %>

<style>
    .dashboard-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        border: 1px solid var(--ui-line) !important;
        border-radius: var(--ui-radius);
        background: var(--ui-surface);
    }
    .dashboard-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(17, 24, 39, 0.08) !important;
    }
    .icon-circle {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
    }
    .bg-soft-teal { background-color: #E6F1F0; color: #006A61; }
    .bg-soft-indigo { background-color: #EEF2FF; color: #4F46E5; }
    .bg-soft-amber { background-color: #FFF9E6; color: #D95F00; }
    .bg-soft-cyan { background-color: #ECFEFF; color: #0891B2; }
    
    .quick-action-btn {
        transition: all 0.2s ease;
        border-radius: 12px;
        border: 1px solid var(--ui-line);
        background: var(--ui-surface);
        padding: 1.25rem;
        display: flex;
        align-items: center;
        text-align: left;
        width: 100%;
    }
    .quick-action-btn:hover {
        background: #F8FAFC;
        border-color: #006A61;
        transform: scale(1.02);
        box-shadow: 0 4px 12px rgba(0, 106, 97, 0.05);
    }
    .quick-action-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin-right: 1rem;
    }
</style>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-4 pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">¡Bienvenido a Academia OS!</h1>
        <p class="text-secondary mb-0">Aquí tienes un resumen general del estado de tu institución escolar.</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0">
        <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-3" onclick="window.location.reload()">
            <span class="me-1">🔄</span> Actualizar Datos
        </button>
    </div>
</div>

<!-- Tarjetas de Estadísticas -->
<div class="row g-4 mb-4">
    <!-- Alumnos -->
    <div class="col-md-6 col-lg-3">
        <div class="card dashboard-card shadow-sm p-4 h-100">
            <div class="d-flex align-items-center">
                <div class="icon-circle bg-soft-teal me-3">
                    👥
                </div>
                <div>
                    <h6 class="text-muted small fw-semibold text-uppercase tracking-wider mb-1">Alumnos</h6>
                    <h2 class="fw-bold mb-0" id="count-alumnos">...</h2>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top">
                <a href="/alumnos" class="text-teal text-decoration-none small fw-semibold d-flex align-items-center">
                    Ver todos los alumnos <span class="ms-1">→</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Profesores -->
    <div class="col-md-6 col-lg-3">
        <div class="card dashboard-card shadow-sm p-4 h-100">
            <div class="d-flex align-items-center">
                <div class="icon-circle bg-soft-indigo me-3">
                    👨‍🏫
                </div>
                <div>
                    <h6 class="text-muted small fw-semibold text-uppercase tracking-wider mb-1">Profesores</h6>
                    <h2 class="fw-bold mb-0" id="count-profesores">...</h2>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top">
                <a href="/profesores" class="text-primary text-decoration-none small fw-semibold d-flex align-items-center">
                    Ver todos los profesores <span class="ms-1">→</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Grupos -->
    <div class="col-md-6 col-lg-3">
        <div class="card dashboard-card shadow-sm p-4 h-100">
            <div class="d-flex align-items-center">
                <div class="icon-circle bg-soft-amber me-3">
                    🏫
                </div>
                <div>
                    <h6 class="text-muted small fw-semibold text-uppercase tracking-wider mb-1">Grupos</h6>
                    <h2 class="fw-bold mb-0" id="count-grupos">...</h2>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top">
                <a href="/grupos" class="text-orange text-decoration-none small fw-semibold d-flex align-items-center">
                    Ver todos los grupos <span class="ms-1">→</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Horarios -->
    <div class="col-md-6 col-lg-3">
        <div class="card dashboard-card shadow-sm p-4 h-100">
            <div class="d-flex align-items-center">
                <div class="icon-circle bg-soft-cyan me-3">
                    📅
                </div>
                <div>
                    <h6 class="text-muted small fw-semibold text-uppercase tracking-wider mb-1">Horarios</h6>
                    <h2 class="fw-bold mb-0" id="count-horarios">...</h2>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top">
                <a href="/horarios" class="text-info text-decoration-none small fw-semibold d-flex align-items-center">
                    Ver todos los horarios <span class="ms-1">→</span>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Sección de Accesos Rápidos -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm p-4 rounded-4 h-100 bg-white">
            <h5 class="fw-bold mb-3 text-dark">⚡ Acciones Rápidas</h5>
            <p class="text-secondary small mb-4">Realiza las tareas más comunes del sistema con un solo clic.</p>
            
            <div class="row g-3">
                <div class="col-sm-6">
                    <a href="/alumnos" class="text-decoration-none">
                        <button class="quick-action-btn">
                            <div class="quick-action-icon bg-soft-teal">➕</div>
                            <div>
                                <div class="fw-bold text-dark small">Nuevo Alumno</div>
                                <div class="text-muted x-small">Registrar estudiante</div>
                            </div>
                        </button>
                    </a>
                </div>
                <div class="col-sm-6">
                    <a href="/profesores" class="text-decoration-none">
                        <button class="quick-action-btn">
                            <div class="quick-action-icon bg-soft-indigo">➕</div>
                            <div>
                                <div class="fw-bold text-dark small">Nuevo Profesor</div>
                                <div class="text-muted x-small">Registrar docente</div>
                            </div>
                        </button>
                    </a>
                </div>
                <div class="col-sm-6">
                    <a href="/grupos" class="text-decoration-none">
                        <button class="quick-action-btn">
                            <div class="quick-action-icon bg-soft-amber">➕</div>
                            <div>
                                <div class="fw-bold text-dark small">Nuevo Grupo</div>
                                <div class="text-muted x-small">Configurar un grupo</div>
                            </div>
                        </button>
                    </a>
                </div>
                <div class="col-sm-6">
                    <a href="/horarios" class="text-decoration-none">
                        <button class="quick-action-btn">
                            <div class="quick-action-icon bg-soft-cyan">➕</div>
                            <div>
                                <div class="fw-bold text-dark small">Asignar Horario</div>
                                <div class="text-muted x-small">Vincular materias y horas</div>
                            </div>
                        </button>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel Informativo / Bienvenida -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm p-4 rounded-4 h-100 text-white" style="background: linear-gradient(135deg, #131B2E 0%, #006A61 100%);">
            <div class="d-flex flex-column h-100 justify-content-between">
                <div>
                    <span class="badge rounded-pill bg-light text-teal mb-3 tracking-widest px-3 py-1 fw-bold x-small">SISTEMA OPERATIVO ESCOLAR</span>
                    <h4 class="fw-bold mb-3">Gestión de Calidad en Academia OS</h4>
                    <p class="text-light-secondary small mb-4" style="opacity: 0.9; line-height: 1.6;">
                        Este panel te permite llevar el control total de las inscripciones, materias, profesores y horarios en tiempo real. Todas las secciones se sincronizan dinámicamente con la base de datos centralizada.
                    </p>
                </div>
                <div class="d-flex align-items-center mt-3">
                    <div class="avatar-group me-3">
                        <img src="https://i.pravatar.cc/150?u=a" class="rounded-circle border border-2 border-white" width="36" alt="Avatar">
                        <img src="https://i.pravatar.cc/150?u=b" class="rounded-circle border border-2 border-white" width="36" alt="Avatar" style="margin-left: -12px;">
                    </div>
                    <p class="mb-0 small" style="opacity: 0.85;">Sistema activo y seguro bajo conexión encriptada.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        // Función auxiliar para cargar conteos dinámicos
        function loadStat(url, elementId) {
            fetch(url)
                .then(res => {
                    if (!res.ok) throw new Error('Error al obtener datos');
                    return res.json();
                })
                .then(payload => {
                    const count = (payload.data && Array.isArray(payload.data)) ? payload.data.length : 0;
                    $(elementId).text(count);
                })
                .catch(err => {
                    console.error('Error al cargar estadística para ' + elementId + ':', err);
                    $(elementId).text('0');
                });
        }

        // Cargar cada estadística
        loadStat('/api/alumnos', '#count-alumnos');
        loadStat('/api/profesores', '#count-profesores');
        loadStat('/api/grupos', '#count-grupos');
        loadStat('/api/horarios', '#count-horarios');
    });
</script>

<%- include('../partials/layout-footer') %>
