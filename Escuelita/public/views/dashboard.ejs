<%- include('../partials/layout-header', { title: 'Dashboard', currentPage: 'dashboard' }) %>
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
                <h1 class="h4 fw-bold">Panel de Control <span class="fw-normal text-muted h6 ms-2">Año Académico 2026-2027</span></h1>
                <div class="d-flex align-items-center gap-3">
                    <div class="search-box position-relative">
                        <%# Barra de búsqueda %>
                    </div>
                    <%# Perfil %>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm p-3 rounded-4">
                        <small class="text-uppercase text-muted fw-bold x-small">Total Alumnos</small>
                        <div class="d-flex justify-content-between align-items-end mt-2">
                            <h2 class="mb-0 fw-bold" id="totalAlumnos">—</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm p-3 rounded-4">
                        <small class="text-uppercase text-muted fw-bold x-small">Profesores</small>
                        <div class="d-flex justify-content-between align-items-end mt-2">
                            <h2 class="mb-0 fw-bold" id="totalProfesores">—</h2>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <%# No sé que poner en el dashboard todavía %>
            </div>

            <script>
            $(document).ready(function () {
                fetch('/api/alumnos')
                    .then(function (res) { return res.json(); })
                    .then(function (payload) {
                        var count = Array.isArray(payload.data) ? payload.data.length : 0;
                        document.getElementById('totalAlumnos').textContent = count;
                    })
                    .catch(function (err) {
                        console.error('Error al obtener alumnos:', err);
                        document.getElementById('totalAlumnos').textContent = 'Error';
                    });

                fetch('/api/profesores')
                    .then(function (res) { return res.json(); })
                    .then(function (payload) {
                        var count = Array.isArray(payload.data) ? payload.data.length : 0;
                        document.getElementById('totalProfesores').textContent = count;
                    })
                    .catch(function (err) {
                        console.error('Error al obtener profesores:', err);
                        document.getElementById('totalProfesores').textContent = 'Error';
                    });
            });
            </script>
<%- include('../partials/layout-footer') %>