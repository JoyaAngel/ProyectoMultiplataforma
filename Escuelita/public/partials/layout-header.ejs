<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Academia OS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/styles.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentModelKey = null;
        let editingRecordId = null;
        let isEditMode = false;
        let currentDeleteModal = null;

        function showMessage(type, text) {
            const box = $("#formMessage");
            box.removeClass("d-none alert-success alert-danger")
                .addClass(type === "success" ? "alert-success" : "alert-danger")
                .text(text);
        }

        function hideMessage() {
            $("#formMessage").addClass("d-none").text("");
        }

        function buildFieldHtml(field) {
            const requiredAttr = field.required ? "required" : "";

            if (field.type === "select") {
                const options = field.options
                    .map(opt => '<option value="' + opt.value + '">' + opt.text + "</option>")
                    .join("");

                return '' +
                    '<div class="col-md-6">' +
                    '<label class="form-label" for="' + field.name + '">' + field.label + "</label>" +
                    '<select class="form-select" id="' + field.name + '" name="' + field.name + '" ' + requiredAttr + ">" +
                    options +
                    "</select>" +
                    "</div>";
            }

            if (field.type === "select-remote") {
                return '' +
                    '<div class="col-md-6">' +
                    '<label class="form-label" for="' + field.name + '">' + field.label + "</label>" +
                    '<select class="form-select" id="' + field.name + '" name="' + field.name + '" ' + requiredAttr + ">" +
                    '<option value="">Cargando...</option>' +
                    "</select>" +
                    "</div>";
            }

            return '' +
                '<div class="col-md-6">' +
                '<label class="form-label" for="' + field.name + '">' + field.label + "</label>" +
                '<input class="form-control" id="' + field.name + '" name="' + field.name + '" type="' + field.type + '" ' + requiredAttr + ">" +
                "</div>";
        }

        async function loadRemoteSelects(fields) {
            for (const field of fields) {
                if (field.type !== "select-remote") continue;

                const res = await fetch(field.source);
                const payload = await res.json();
                const items = payload.data || [];
                const select = $("#" + field.name);

                select.empty();
                select.append('<option value="">Seleccione</option>');

                items.forEach(item => {
                    const value = item[field.valueKey];
                    const text = item[field.textKey];
                    select.append('<option value="' + value + '">' + text + "</option>");
                });
            }
        }

        async function openForm(modelKey, recordData = null) {
            const formsModule = await import("/assets/js/config/forms.js");
            const FORMS_CONFIG = formsModule.FORMS_CONFIG;

            const cfg = FORMS_CONFIG[modelKey];
            if (!cfg) {
                console.error("No existe FORMS_CONFIG para:", modelKey);
                return;
            }

            currentModelKey = modelKey;
            isEditMode = !!recordData;
            editingRecordId = recordData ? recordData[cfg.idField] : null;
            hideMessage();

            const fieldsHtml = cfg.fields.map(buildFieldHtml).join("");
            const formHtml = '' +
                '<form id="dynamicForm" onsubmit="onSubmitDynamicForm(event)">' +
                '<div class="row g-3">' + fieldsHtml + "</div>" +
                '<div class="mt-3">' +
                '<button type="submit" class="btn btn-success">' + cfg.submitLabel + "</button>" +
                '<button type="button" class="btn btn-secondary ms-2" onclick="closeForm()">Cancelar</button>' +
                "</div>" +
                "</form>";

            const title = isEditMode ? (cfg.titleEdit || cfg.title) : cfg.title;
            $("#formTitle").text(title);
            $("#formContainer").html(formHtml);
            $("#formPanel").removeClass("d-none");

            // Cargar selects remotos
            await loadRemoteSelects(cfg.fields);

            // Si estamos en modo edición, llenar el formulario con los datos
            if (isEditMode && recordData) {
                populateForm(recordData);
            }
        }

        function populateForm(data) {
            Object.keys(data).forEach(key => {
                const field = $(`[name="${key}"]`);
                if (field.length) {
                    if (field.is('input[type="date"]')) {
                        // Formato correcto para input date
                        const date = new Date(data[key]);
                        field.val(date.toISOString().split('T')[0]);
                    } else if (field.is('select')) {
                        field.val(data[key] || "");
                    } else {
                        field.val(data[key] || "");
                    }
                }
            });
        }

        function closeForm() {
            $("#formPanel").addClass("d-none");
            $("#formContainer").empty();
            hideMessage();
            currentModelKey = null;
            editingRecordId = null;
            isEditMode = false;
        }

        async function onSubmitDynamicForm(event) {
            event.preventDefault();
            console.log("onSubmitDynamicForm called - Edit mode:", isEditMode);

            try {
                const formsModule = await import("/assets/js/config/forms.js");
                const FORMS_CONFIG = formsModule.FORMS_CONFIG;

                const cfg = FORMS_CONFIG[currentModelKey];
                if (!cfg) {
                    console.error("Config not found for:", currentModelKey);
                    return;
                }

                hideMessage();

                const form = document.getElementById('dynamicForm') || event.target;
                console.log("Form element:", form);
                
                const formData = new FormData(form);
                const body = Object.fromEntries(formData.entries());

                // Convertir valores vacíos en null para campos select
                Object.keys(body).forEach(key => {
                    if (body[key] === '') {
                        body[key] = null;
                    }
                });

                console.log("Sending data:", body);

                // Determinar el método y el endpoint
                const method = isEditMode ? "PUT" : "POST";
                const endpoint = isEditMode 
                    ? `${cfg.endpoint}/${editingRecordId}`
                    : cfg.endpoint;

                console.log(`${method} request to:`, endpoint);

                const res = await fetch(endpoint, {
                    method: method,
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(body)
                });

                console.log("Response status:", res.status, "ok:", res.ok);

                const payload = await res.json();
                console.log("Payload:", payload);

                if (!res.ok) {
                    const errorMsg = payload.error || "Error al guardar";
                    console.error("Error message to show:", errorMsg);
                    showMessage("error", errorMsg);
                    return;
                }

                const successMsg = isEditMode 
                    ? (payload.message || "Actualizado correctamente")
                    : (payload.message || "Guardado correctamente");
                
                showMessage("success", successMsg);
                form.reset();
                
                // Recargar la tabla usando DataTables API
                try {
                    const tableId = '#' + currentModelKey + 'Table';
                    const table = $(tableId).DataTable();
                    if (table && typeof table.ajax.reload === 'function') {
                        table.ajax.reload();
                    }
                } catch (tableError) {
                    console.warn("No se pudo recargar la tabla:", tableError);
                }
            } catch (error) {
                console.error("Error en submit:", error);
                showMessage("error", "Error de red o servidor");
            }
        }

        async function deleteRecord(modelKey, recordId, recordName) {
            // Mostrar el modal de confirmación
            document.getElementById('deleteModalTitle').textContent = `Eliminar ${recordName}`;
            document.getElementById('deleteModalMessage').textContent = `¿Está seguro de que desea eliminar "${recordName}"? Esta acción no se puede deshacer.`;
            
            // Guardar los parámetros para usarlos en la confirmación
            window.deleteParams = { modelKey, recordId, recordName };
            
            // Mostrar el modal y guardar la referencia
            currentDeleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            currentDeleteModal.show();
        }

        async function confirmDelete() {
            const { modelKey, recordId, recordName } = window.deleteParams;

            try {
                const formsModule = await import("/assets/js/config/forms.js");
                const FORMS_CONFIG = formsModule.FORMS_CONFIG;
                const cfg = FORMS_CONFIG[modelKey];
                
                if (!cfg) {
                    showMessage("error", "Configuración no encontrada para: " + modelKey);
                    return;
                }

                const endpoint = `${cfg.endpoint}/${recordId}`;
                
                const response = await fetch(endpoint, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });

                if (!response.ok) {
                    const error = await response.json();
                    showMessage("error", "Error al eliminar: " + (error.error || "Error desconocido"));
                    return;
                }

                const data = await response.json();
                showMessage("success", data.message || "Registro eliminado correctamente");

                // Cerrar el modal
                if (currentDeleteModal) {
                    currentDeleteModal.hide();
                    currentDeleteModal = null;
                }

                // Recargar la tabla
                try {
                    const tableId = '#' + modelKey + 'Table';
                    const table = $(tableId).DataTable();
                    if (table && typeof table.ajax.reload === 'function') {
                        table.ajax.reload();
                    }
                } catch (tableError) {
                    console.warn("No se pudo recargar la tabla:", tableError);
                }
            } catch (error) {
                console.error("Error al eliminar registro:", error);
                showMessage("error", "Error de red o servidor");
            }
        }

        function cancelDelete() {
            if (currentDeleteModal) {
                currentDeleteModal.hide();
            }
        }
    </script>
</head>
<body>

<%- include('navbar') %>

<div class="container-fluid">
    <div class="row">
        <%- include('sidebar') %>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 bg-light">

        <div id="formPanel" class="d-none">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h2 id="formTitle"></h2>
                <button onclick="closeForm()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--ui-muted);">
                    ×
                </button>
            </div>
            <div id="formMessage" class="d-none"></div>
            <div id="formContainer"></div>
        </div>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="deleteConfirmModalLabel">🗑️ Confirmar eliminación</h5>
                <button type="button" class="btn-close" onclick="cancelDelete()" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h6 id="deleteModalTitle"></h6>
                <p id="deleteModalMessage" class="text-muted mb-0"></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" onclick="cancelDelete()">
                    Cancelar
                </button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                    <span>🗑️ Eliminar</span>
                </button>
            </div>
        </div>
    </div>
</div>
